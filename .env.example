# Скопируйте этот файл в .env и подставьте свои значения:
#   copy .env.example .env     (Windows CMD)
#   Copy-Item .env.example .env   (PowerShell)

# --- Обязательно в продакшене ---
# Случайная строка для сессий Flask и подписей (сгенерируйте новую):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Токен доступа к админке — первый сегмент пути в URL:
#   https://ваш-домен/<ВОТ_ЭТА_СТРОКА>/admin/
# Придумайте длинную случайную строку (без пробелов и слешей), например:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Или оставьте пустым — тогда подставится dev-значение из кода (только для локальной разработки).
ADMIN_SECRET_TOKEN=

# Опционально: тот же SECRET_KEY, если не задан — берётся SECRET_KEY выше.
# Нужен только если входите в админку по JWT вместо простой строки.
JWT_SECRET_KEY=

# Опционально: URI базы (по умолчанию SQLite в папке instance/)
# DATABASE_URL=sqlite:///D:/projects/banketptz/instance/banket.db
